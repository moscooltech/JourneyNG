# Copy to .env (never commit real .env files)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://journey:journey_dev_password@localhost:5432/journey
REDIS_URL=redis://localhost:6379/0

# Auth — REQUIRED in staging/production. Generates an insecure dev default in development only.
JWT_SECRET=change-me-32+random-chars
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=14

# Guest / invitation lifetimes
GUEST_TOKEN_EXPIRES_HOURS=12
INVITATION_EXPIRES_MINUTES=120

# Journey bounds
JOURNEY_MIN_DURATION_MINUTES=15
JOURNEY_MAX_DURATION_HOURS=24
MAX_ACTIVE_PARTICIPANTS=20

# Live location
LOCATION_UPLOAD_MIN_INTERVAL_MS=2500
LOCATION_STALE_AFTER_SECONDS=30
LOCATION_MAX_ACCURACY_M=200
ARRIVAL_RADIUS_M=75
ARRIVAL_STABILITY_COUNT=3
LOCATION_RETENTION_HOURS=24

# Rate limits (per scope)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_INVITATION_CREATE_PER_MIN=20
RATE_LIMIT_JOIN_PER_MIN=10
RATE_LIMIT_LOCATION_PER_MIN=60
RATE_LIMIT_WS_PER_MIN=30

# CORS (JSON list)
CORS_ORIGINS='["https://app.example.com"]'

# Mapbox (server-side only; mobile uses its own public token)
MAPBOX_SERVER_TOKEN=

# Firebase Cloud Messaging (optional in development)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Error reporting (optional)
SENTRY_DSN=
